// A review submitted from a page's Review panel as a GitHub issue → a pull request into reviews/inbox/.
//
// Run by .github/workflows/review-submission.yml, one subcommand per job:
//
//   validate --out <dir>    read the issue from $GITHUB_EVENT_PATH, validate the review with the code
//                           `npm run check` uses (scripts/reviews.mts), and if it is valid write it to
//                           reviews/inbox/issue-<n>.json, run `bh.mts index`, and copy that file and the
//                           regenerated review data to <dir>/files. Always writes <dir>/result.json.
//   apply --from <dir>      copy those files (a fixed list, never a path from the issue) into the checkout
//   propose                 open the pull request for the branch (or say where to open it by hand), and
//                           start CI on the branch, which a PR opened by Actions would not start
//   withdraw                after an edit made the review invalid: close its PR and delete its branch
//   cleanup                 after the issue was closed: the same, so an unmerged submission leaves nothing behind
//   report                  post (or update) the one comment on the issue that says what happened
//
// The issue body is untrusted. It is read from the event file, never from an expression or an env
// var, only `validate` parses it, and that job's token can only read. No dependencies: the
// workflow runs this without `npm ci`.

import fs from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";
import { reviewProblems } from "./reviews.mts";
import type { ReviewFile } from "./types.mts";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

/** The issue form's label (the trigger) and the label of its review field. Keep equal to .github/ISSUE_TEMPLATE/review-submission.yml. */
export const LABEL = "review-submission";
export const FIELD_LABEL = "Review file";
/** GitHub's own limit on an issue body. */
export const MAX_BODY_CHARS = 65_536;
/** Largest review accepted from an issue. A larger one goes into reviews/inbox/ by pull request. */
export const MAX_REVIEW_BYTES = 60_000;
/** Generated by `npm run index` from reviews/: the PR carries them so that `check` passes on it. */
export const GENERATED = ["theme/reviews.js", "theme/site.js", "theme/unlisted-reviews.js"];
/** First line of the workflow's comment, so a re-run edits it instead of adding another. */
export const MARKER = "<!-- bh-review-submission -->";
export const BOT_LOGIN = "github-actions[bot]";

export const reviewPath = (n: number) => `reviews/inbox/issue-${n}.json`;
export const branchFor = (n: number) => `review-submission/issue-${n}`;
const isIssueNumber = (n: unknown): n is number => typeof n === "number" && Number.isSafeInteger(n) && n > 0;

/** What `validate` decided, as written to result.json. */
export interface SubmissionResult {
  ok: boolean;
  number: number;
  problems: string[];
  document?: string;
  comments?: number;
}

// ---- reading the issue ---------------------------------------------------------------------

const FENCE = /^(`{3,}|~{3,})(.*)$/;

/** The text inside the first fenced block of `text`, or null when it has none. */
function unfence(text: string): string | null {
  const lines = text.split("\n");
  const open = lines.findIndex((l) => FENCE.test(l.trim()));
  if (open < 0) return null;
  const marker = lines[open].trim().match(FENCE)![1];
  const close = lines.findIndex((l, i) => i > open && new RegExp(`^${marker[0] === "`" ? "`" : "~"}{${marker.length},}\\s*$`).test(l.trim()));
  return lines.slice(open + 1, close < 0 ? undefined : close).join("\n");
}

/**
 * The review JSON from an issue body written by the form: the "### Review file" section, inside the
 * json fence that `render: json` adds. A body with no such heading is taken whole. A reader who
 * pasted their own fence inside the field gets it removed too.
 */
export function extractReview(body: unknown): { json: string } | { problem: string } {
  if (typeof body !== "string" || !body.trim()) return { problem: "The issue is empty. Paste the review file into the Review file field." };
  if (body.length > MAX_BODY_CHARS) return { problem: `The issue is longer than GitHub allows (${MAX_BODY_CHARS} characters).` };
  const text = body.replace(/^﻿/, "").replace(/\r\n?/g, "\n");
  const lines = text.split("\n");
  const head = lines.findIndex((l) => l.trim() === `### ${FIELD_LABEL}`);
  let section = text;
  if (head >= 0) {
    const next = lines.findIndex((l, i) => i > head && /^###\s/.test(l));
    section = lines.slice(head + 1, next < 0 ? undefined : next).join("\n");
  }
  for (let inner = unfence(section), guard = 0; inner !== null && guard < 3; inner = unfence(section), guard++) section = inner;
  const json = section.replace(/^﻿/, "").trim();
  if (!json || json === "_No response_") return { problem: "The Review file field is empty. Paste the file the page's Review panel exports into it." };
  const bytes = Buffer.byteLength(json, "utf8");
  if (bytes > MAX_REVIEW_BYTES) return { problem: `The review is ${bytes} bytes; an issue takes at most ${MAX_REVIEW_BYTES}. Add the downloaded file to reviews/inbox/ in a pull request instead.` };
  return { json };
}

/** Validate a submitted review exactly as `npm run check` would validate it as reviews/inbox/issue-<n>.json. */
export function validateSubmission(root: string, body: unknown, number: number): SubmissionResult & { review?: ReviewFile } {
  if (!isIssueNumber(number)) throw new Error(`not an issue number: ${String(number)}`);
  const fail = (problems: string[]): SubmissionResult => ({ ok: false, number, problems });
  const extracted = extractReview(body);
  if ("problem" in extracted) return fail([extracted.problem]);
  let review: unknown;
  try { review = JSON.parse(extracted.json); } catch (e) { return fail([`The review is not valid JSON: ${(e as Error).message}`]); }
  const rel = reviewPath(number);
  const all = reviewProblems(root, { extra: [{ rel, review }] });
  // Without the schema nothing was checked: fail rather than accept.
  const broken = all.find((p) => p.startsWith("reviews/schema.json:"));
  if (broken) throw new Error(broken);
  // Problems with files already in the repo are not this reader's to fix; problems with theirs start with its path.
  const problems = all.filter((p) => p.startsWith(rel + ":"));
  const r = review as ReviewFile;
  if (!problems.length && Array.isArray(r.comments) && !r.comments.length) problems.push(`${rel}: has no comments`);
  if (problems.length) return fail(problems);
  return { ok: true, number, problems: [], document: r.document, comments: r.comments!.length, review: r };
}

/** The `validate` job: decide, and if the review is valid stage it and the data it regenerates under `out/files`. */
export function prepareSubmission(root: string, body: unknown, number: number, out: string, { index = true } = {}): SubmissionResult {
  const { review, ...result } = validateSubmission(root, body, number);
  fs.mkdirSync(out, { recursive: true });
  if (result.ok && review) {
    const rel = reviewPath(number);
    fs.mkdirSync(path.dirname(path.join(root, rel)), { recursive: true });
    fs.writeFileSync(path.join(root, rel), JSON.stringify(review, null, 2) + "\n");
    if (index) {
      const run = spawnSync(process.execPath, [path.join(root, "scripts", "bh.mts"), "index"], { cwd: root, encoding: "utf8", timeout: 120_000 });
      if (run.status !== 0) throw new Error(`bh.mts index failed: ${run.error?.message ?? ""}${run.stdout}${run.stderr}`);
    }
    for (const p of [rel, ...GENERATED]) {
      fs.mkdirSync(path.dirname(path.join(out, "files", p)), { recursive: true });
      fs.copyFileSync(path.join(root, p), path.join(out, "files", p));
    }
  }
  fs.writeFileSync(path.join(out, "result.json"), JSON.stringify(result, null, 2) + "\n");
  return result;
}

/** The `apply` step: copy the staged files into the checkout. Only these paths, whatever else `from` holds. */
export function applySubmission(root: string, from: string, number: number): string[] {
  if (!isIssueNumber(number)) throw new Error(`not an issue number: ${String(number)}`);
  const paths = [reviewPath(number), ...GENERATED];
  for (const p of paths) {
    const src = path.join(from, "files", p);
    if (!fs.lstatSync(src).isFile()) throw new Error(`${p} is not a file in the staged submission`);
    if (p === paths[0]) JSON.parse(fs.readFileSync(src, "utf8"));
    fs.mkdirSync(path.dirname(path.join(root, p)), { recursive: true });
    fs.copyFileSync(src, path.join(root, p));
  }
  return paths;
}

// ---- talking to GitHub -------------------------------------------------------------------------

export type Fetch = (url: string, init?: { method?: string; headers?: Record<string, string>; body?: string; signal?: AbortSignal }) => Promise<{ ok: boolean; status: number; json(): Promise<unknown> }>;

interface Api { repo: string; token: string; fetch?: Fetch; api?: string }

async function call({ repo, token, fetch: f = globalThis.fetch as unknown as Fetch, api = "https://api.github.com" }: Api, method: string, route: string, body?: unknown) {
  const res = await f(`${api}/repos/${repo}${route}`, {
    method,
    headers: { authorization: `Bearer ${token}`, accept: "application/vnd.github+json", "x-github-api-version": "2022-11-28", "content-type": "application/json", "user-agent": "bh-review-submission" },
    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
    signal: AbortSignal.timeout(30_000), // fail by name, well inside the job's timeout
  });
  let data: unknown = null;
  try { data = await res.json(); } catch { /* no body */ }
  return { ok: res.ok, status: res.status, data };
}

const PR_URL = /^https:\/\/github\.com\/[\w.-]+\/[\w.-]+\/pull\/\d+$/;
const REPO = /^[\w.-]+\/[\w.-]+$/;
const safeDocument = (d: unknown) => (typeof d === "string" && /^docs\/[a-z0-9._-]+\.html$/.test(d) ? d : null);

export function pullRequestBody(result: SubmissionResult): string {
  const doc = safeDocument(result.document);
  return [
    `Adds the review submitted in #${result.number}${doc ? ` on \`${doc}\`` : ""} (${result.comments ?? 0} comment${result.comments === 1 ? "" : "s"}) to \`reviews/inbox/\`, with the review data \`npm run index\` regenerates from it.`,
    "",
    "The review-submission workflow validated it with the rules `npm run check` applies to review files. Read the comments before merging: merging publishes them on the page.",
    "",
    "GitHub does not start CI for a pull request that GitHub Actions opens, so the workflow started CI on this branch itself. If `main` has moved since, update the branch, run `npm run index`, and let CI run again before merging: the regenerated review data here was built from `main` as it was.",
    "",
    `Closes #${result.number}`,
  ].join("\n");
}

/** Open the PR for the branch (or find the open one). When Actions may not open PRs here, return a compare link instead. */
export async function proposePullRequest(api: Api, result: SubmissionResult, base: string): Promise<{ prUrl?: string; compareUrl?: string; reason?: string }> {
  if (!REPO.test(api.repo)) throw new Error(`not a repository: ${api.repo}`);
  const head = branchFor(result.number), owner = api.repo.split("/")[0];
  const open = await call(api, "GET", `/pulls?state=open&head=${encodeURIComponent(`${owner}:${head}`)}`);
  const existing = Array.isArray(open.data) ? (open.data[0] as { html_url?: unknown } | undefined)?.html_url : undefined;
  if (open.ok && typeof existing === "string" && PR_URL.test(existing)) return { prUrl: existing };
  const made = await call(api, "POST", "/pulls", { title: `Add the review submitted in #${result.number}`, head, base, body: pullRequestBody(result), maintainer_can_modify: true });
  const url = (made.data as { html_url?: unknown } | null)?.html_url;
  if (made.ok && typeof url === "string" && PR_URL.test(url)) return { prUrl: url };
  const message = (made.data as { message?: unknown } | null)?.message;
  return { compareUrl: `https://github.com/${api.repo}/compare/${encodeURIComponent(base)}...${head}?expand=1`, reason: `HTTP ${made.status}${typeof message === "string" ? `: ${message}` : ""}` };
}

/** Start CI (ci.yml has `workflow_dispatch`) on the branch. Events made with the Actions token start no workflows, except a dispatch. */
export async function dispatchChecks(api: Api, branch: string, workflow = "ci.yml"): Promise<boolean> {
  return (await call(api, "POST", `/actions/workflows/${workflow}/dispatches`, { ref: branch })).ok;
}

/** An edit made the review invalid: close the pull request proposed from the earlier version and delete its branch. */
export async function withdrawPullRequest(api: Api, number: number): Promise<{ closed: number; deleted: boolean }> {
  if (!REPO.test(api.repo)) throw new Error(`not a repository: ${api.repo}`);
  const head = branchFor(number), owner = api.repo.split("/")[0];
  const open = await call(api, "GET", `/pulls?state=open&head=${encodeURIComponent(`${owner}:${head}`)}`);
  if (!open.ok || !Array.isArray(open.data)) throw new Error(`listing pull requests failed: HTTP ${open.status}`);
  let closed = 0;
  for (const pr of open.data as { number?: unknown }[]) {
    if (!isIssueNumber(pr.number)) continue;
    const res = await call(api, "PATCH", `/pulls/${pr.number}`, { state: "closed" });
    if (!res.ok) throw new Error(`closing #${pr.number} failed: HTTP ${res.status}`);
    closed++;
  }
  const del = await call(api, "DELETE", `/git/refs/heads/${head}`);
  if (!del.ok && del.status !== 404 && del.status !== 422) throw new Error(`deleting ${head} failed: HTTP ${del.status}`);
  return { closed, deleted: del.ok };
}

// ---- the comment on the issue -------------------------------------------------------------------

/** Strip what could hide or reorder text (controls, bidi overrides) and cap the length. */
function clean(line: string, max = 300): string {
  const chars = [...line.replace(/[\u0000-\u0008\u000B-\u001F\u007F-\u009F​-‏‪-‮⁠-⁩﻿]/g, "").replace(/\n/g, " ")];
  return chars.length > max ? chars.slice(0, max - 1).join("") + "…" : chars.join("");
}

/** Lines in a fenced code block that nothing inside can close: GitHub renders it as plain text (no HTML, links or @mentions). */
export function codeBlock(lines: string[], maxLines = 30): string {
  const shown = lines.slice(0, maxLines).map((l) => clean(l));
  if (lines.length > maxLines) shown.push(`… and ${lines.length - maxLines} more`);
  const longest = Math.max(0, ...shown.map((l) => Math.max(0, ...[...l.matchAll(/`+/g)].map((m) => m[0].length))));
  const fence = "`".repeat(Math.max(3, longest + 1));
  return `${fence}text\n${shown.join("\n")}\n${fence}`;
}

export interface ReportInput {
  result: SubmissionResult | null; // null: validate did not finish
  validate: string; // needs.validate.result: "success" when it finished
  unchanged?: boolean; // main already holds exactly this review
  withdrawn?: boolean; // an earlier version's pull request was closed
  prUrl?: string;
  compareUrl?: string;
  runUrl?: string;
}

export function reportBody(input: ReportInput): string {
  const { result } = input;
  const run = input.runUrl && /^https:\/\/github\.com\/[\w.-]+\/[\w.-]+\/actions\/runs\/\d+$/.test(input.runUrl) ? ` ([workflow run](${input.runUrl}))` : "";
  const out = [MARKER];
  if (!result || input.validate !== "success") {
    out.push(`The check of this review could not run${run}. A maintainer will look at it.`);
  } else if (!result.ok) {
    out.push(
      "Thank you for the review. It can't be accepted yet:",
      "",
      codeBlock(result.problems),
      "",
      "Edit this issue to fix it: the check runs again on every edit. The **Review file** field must hold the whole file that the page's Review panel exports, unchanged. A review that is too large for an issue can instead be added to `reviews/inbox/` in a pull request.",
    );
    if (input.withdrawn) out.push("", "The pull request proposed from the earlier version of this issue was closed.");
  } else {
    const doc = safeDocument(result.document);
    const what = `Your review (${result.comments} comment${result.comments === 1 ? "" : "s"}${doc ? ` on \`${doc}\`` : ""}) passed the checks`;
    if (input.unchanged) {
      out.push(`${what}. The repository already holds exactly this review, so there is nothing new to propose.`);
    } else if (input.prUrl && PR_URL.test(input.prUrl)) {
      out.push(`${what}, and ${input.prUrl} proposes adding it. Once it is merged, your comments appear on the page for every reader, and this issue closes.`);
    } else if (input.compareUrl && input.compareUrl.startsWith("https://github.com/") && !/[\s()<>]/.test(input.compareUrl)) {
      out.push(`${what} and is on the branch \`${branchFor(result.number)}\`. GitHub Actions may not open pull requests in this repository, so a maintainer will [open the pull request](${input.compareUrl}). Once it is merged, your comments appear on the page for every reader.`);
    } else {
      out.push(`${what}, but proposing it as a pull request failed${run}. A maintainer will look at it.`);
    }
  }
  return out.join("\n") + "\n";
}

/** Post the report, or edit the workflow's earlier report on this issue. */
export async function postReport(api: Api, number: number, body: string): Promise<string> {
  let mine: number | undefined;
  for (let page = 1; page <= 10 && mine === undefined; page++) {
    const list = await call(api, "GET", `/issues/${number}/comments?per_page=100&page=${page}`);
    if (!list.ok || !Array.isArray(list.data)) throw new Error(`listing comments failed: HTTP ${list.status}`);
    const found = (list.data as { id: number; body?: string; user?: { login?: string } }[]).find((c) => c.user?.login === BOT_LOGIN && (c.body ?? "").startsWith(MARKER));
    if (found) mine = found.id;
    if (list.data.length < 100) break;
  }
  const res = mine === undefined ? await call(api, "POST", `/issues/${number}/comments`, { body }) : await call(api, "PATCH", `/issues/comments/${mine}`, { body });
  if (!res.ok) throw new Error(`posting the comment failed: HTTP ${res.status}`);
  return (res.data as { html_url?: string }).html_url ?? "";
}

// ---- command line ------------------------------------------------------------------------------

function event(): { issue: { number: number; body: unknown }; repository?: { default_branch?: string } } {
  const file = process.env.GITHUB_EVENT_PATH;
  if (!file) throw new Error("GITHUB_EVENT_PATH is not set");
  const e = JSON.parse(fs.readFileSync(file, "utf8"));
  if (!isIssueNumber(e?.issue?.number)) throw new Error("the event has no issue number");
  return e;
}

function output(values: Record<string, string>): void {
  const lines = Object.entries(values).map(([k, v]) => { if (/[\r\n]/.test(v)) throw new Error(`output ${k} has a newline`); return `${k}=${v}\n`; }).join("");
  if (process.env.GITHUB_OUTPUT) fs.appendFileSync(process.env.GITHUB_OUTPUT, lines);
  else process.stdout.write(lines);
}

const arg = (args: string[], name: string) => { const i = args.indexOf(name); if (i < 0 || !args[i + 1]) throw new Error(`${name} <dir> is required`); return path.resolve(args[i + 1]); };
const env = (name: string) => { const v = process.env[name]; if (!v) throw new Error(`${name} is not set`); return v; };

export async function main(argv = process.argv.slice(2)): Promise<number> {
  const [cmd, ...args] = argv;
  const e = event(), n = e.issue.number;
  if (cmd === "validate") {
    const result = prepareSubmission(ROOT, e.issue.body, n, arg(args, "--out"));
    console.log(result.ok ? `Valid: ${result.comments} comments on ${result.document}` : `Not accepted:\n  ${result.problems.map((p) => clean(p)).join("\n  ")}`);
    output({ ok: String(result.ok) });
  } else if (cmd === "apply") {
    const paths = applySubmission(ROOT, arg(args, "--from"), n);
    output({ branch: branchFor(n), review: paths[0], number: String(n) });
  } else if (cmd === "propose") {
    const result = JSON.parse(fs.readFileSync(path.join(arg(args, "--from"), "result.json"), "utf8")) as SubmissionResult;
    const base = e.repository?.default_branch && /^[\w./-]+$/.test(e.repository.default_branch) ? e.repository.default_branch : "main";
    const got = await proposePullRequest({ repo: env("GITHUB_REPOSITORY"), token: env("GITHUB_TOKEN") }, { ...result, number: n }, base);
    if (got.reason) console.log(`::notice::No pull request opened (${clean(got.reason)}); the comment links the compare page instead`);
    if (!(await dispatchChecks({ repo: env("GITHUB_REPOSITORY"), token: env("GITHUB_TOKEN") }, branchFor(n)))) console.log("::warning::Could not start CI on the branch; close and reopen the pull request to run it");
    output({ pr_url: got.prUrl ?? "", compare_url: got.compareUrl ?? "" });
  } else if (cmd === "withdraw") {
    const got = await withdrawPullRequest({ repo: env("GITHUB_REPOSITORY"), token: env("GITHUB_TOKEN") }, n);
    console.log(`Closed ${got.closed} pull request(s); branch ${got.deleted ? "deleted" : "not present"}`);
    output({ withdrawn: String(got.closed > 0) });
  } else if (cmd === "cleanup") {
    // A merged pull request is not open, and its branch may already be gone: both are a no-op here.
    const got = await withdrawPullRequest({ repo: env("GITHUB_REPOSITORY"), token: env("GITHUB_TOKEN") }, n);
    console.log(`Closed ${got.closed} pull request(s); branch ${got.deleted ? "deleted" : "not present"}`);
  } else if (cmd === "report") {
    let result: SubmissionResult | null = null;
    try { result = JSON.parse(fs.readFileSync(path.join(arg(args, "--from"), "result.json"), "utf8")) as SubmissionResult; } catch { /* validate did not finish */ }
    if (result) result.number = n;
    const body = reportBody({
      result, validate: process.env.VALIDATE_RESULT ?? "",
      unchanged: process.env.UNCHANGED === "true", withdrawn: process.env.WITHDRAWN === "true",
      prUrl: process.env.PR_URL, compareUrl: process.env.COMPARE_URL, runUrl: process.env.RUN_URL,
    });
    console.log(await postReport({ repo: env("GITHUB_REPOSITORY"), token: env("GITHUB_TOKEN") }, n, body));
  } else {
    console.error("usage: review-submission.mts validate --out <dir> | apply --from <dir> | propose --from <dir> | withdraw | cleanup | report --from <dir>");
    return 2;
  }
  return 0;
}

// realpath: a temp directory (macOS /var → /private/var) or a linked checkout must still count as running this file.
if (process.argv[1] && fs.realpathSync(process.argv[1]) === fs.realpathSync(fileURLToPath(import.meta.url))) process.exitCode = await main();
