// social-cards.txt: what each social card in docs/assets/og/ was rendered from (contracts/social-cards.md).
//
// One line per card, sorted by slug: the slug, the card's staleness key (the hash of everything it is
// drawn from, or `fallback` for a copy of the shared site card) and the SHA-256 of the PNG on disk. The
// key lives here rather than in the PNG, so a re-render that draws the same pixels leaves the PNG's
// bytes alone and only this text changes; and text, unlike a PNG, merges line by line.
//
// `npm run cards` writes it; `check` reads it with no browser. Parsing is forgiving so that `cards` can
// repair a file left mid-merge (a line it cannot read, or a slug listed twice, counts as no record and
// the card is drawn again); `check` reports the same lines as problems, and any departure from the
// canonical text, so a hand edit or a half-resolved conflict cannot pass.

/** The file's name, at the root of the repository: outside docs/ and theme/, so it is never published. */
export const CARD_RECORDS_FILE = "social-cards.txt";

export const CARD_RECORDS_HEADER = [
  "# Social cards: generated by `npm run cards`; do not edit (contracts/social-cards.md).",
  "# On a merge conflict, take either side, then run `npm run cards`.",
  "# <slug> <staleness key, or fallback> <sha-256 of docs/assets/og/<slug>.png>",
].join("\n");

/** One card's record: the key it was rendered for and the hash of the PNG that was committed for it. */
export interface CardRecord { key: string; png: string }

const HEX64 = /^[0-9a-f]{64}$/;

/** The records in `text`, and a problem for each line that is not a record or names a slug again. */
export function parseCardRecords(text: string): { records: Map<string, CardRecord>; problems: string[] } {
  const records = new Map<string, CardRecord>(), problems: string[] = [], twice = new Set<string>();
  text.split("\n").forEach((line, i) => {
    if (!line.trim() || line.startsWith("#")) return;
    const [slug, key, png, ...rest] = line.trim().split(/\s+/);
    if (!slug || !key || !png || rest.length || !(HEX64.test(key) || key === "fallback") || !HEX64.test(png)) {
      problems.push(`line ${i + 1} is not "<slug> <key> <png hash>": ${JSON.stringify(line.length > 60 ? line.slice(0, 60) + "…" : line)}`);
      return;
    }
    if (records.has(slug) || twice.has(slug)) {
      problems.push(`line ${i + 1} lists ${slug} again`);
      records.delete(slug);
      twice.add(slug);
      return;
    }
    records.set(slug, { key, png });
  });
  return { records, problems };
}

/** The canonical text of `records`: the header, then one line per card in slug order. */
export function renderCardRecords(records: Map<string, CardRecord>): string {
  const lines = [...records].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)).map(([slug, r]) => `${slug} ${r.key} ${r.png}`);
  return [CARD_RECORDS_HEADER, ...lines].join("\n") + "\n";
}
